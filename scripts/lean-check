#!/usr/bin/env bash
# lean-check: smoke test of the scratch project (versions, narrow and full Mathlib import,
# field_simp/ring/norm_num, axioms, sorry detection). Prints timings.
set -uo pipefail
work=${LEAN_WORK:-$HOME/work}
cd "$work/scratch" || { echo "no scratch project; run lean-init" >&2; exit 3; }
d=$work/runs/lean-check
mkdir -p "$d"

cat > "$d/narrow.lean" <<'EOF'
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.Ring
import Mathlib.Algebra.Field.Rat
example (a b : ℚ) (hb : b ≠ 0) : a / b * b = a := by field_simp
example (x y : ℚ) : (x + y)^2 = x^2 + 2*x*y + y^2 := by ring
#eval (1/3 + 1/6 : ℚ)
#eval Lean.versionString
EOF
cat > "$d/full.lean" <<'EOF'
import Mathlib
theorem lean_check_t1 : (2:ℚ) + 2 = 4 := by norm_num
#print axioms lean_check_t1
example : 1 = 2 := by sorry
EOF

rc=0
for f in narrow full; do
    s=$(date +%s%N)
    lake env lean "$d/$f.lean" > "$d/$f.out" 2>&1; r=$?
    cat "$d/$f.out"
    echo "-- $f.lean: exit $r, $(( ($(date +%s%N) - s) / 1000000 )) ms"
    (( r == 0 )) || rc=1
done
if grep -qF 'declaration uses `sorry`' "$d/full.out"; then
    echo "-- sorry warning detected (expected)"
else
    echo "-- sorry warning NOT seen"; rc=1
fi
(( rc == 0 )) && echo "lean-check: ok" || echo "lean-check: FAILED"
exit $rc
